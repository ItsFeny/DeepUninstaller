<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>DeepUninstaller</AssemblyName>
    <RootNamespace>DeepUninstaller</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Label="Metadatos">
    <Version>1.1.0</Version>
    <Product>Deep Uninstaller</Product>
    <AssemblyTitle>Deep Uninstaller</AssemblyTitle>
    <Authors>Feny Martínez</Authors>
    <Copyright>Copyright (c) 2026 Feny Martínez</Copyright>
    <RepositoryUrl>https://github.com/ItsFeny/DeepUninstaller</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <!-- Namespaces del proyecto disponibles en todos los archivos -->
  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="DeepUninstaller.Models" />
    <Using Include="DeepUninstaller.Infrastructure" />
    <Using Include="DeepUninstaller.Services.Scanning" />
    <Using Include="DeepUninstaller.Services.Cleaning" />
    <Using Include="DeepUninstaller.UI" />
    <Using Include="DeepUninstaller.UI.ViewModels" />
    <Using Include="DeepUninstaller.UI.Views" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\MaterialIcons-Regular.ttf" />
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app.png" />
  </ItemGroup>

</Project>
