<Window x:Class="DeepUninstaller.UI.Views.Dialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" SizeToContent="Height" Width="580"
        FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource Text}">
  <Border Background="{StaticResource Surface}" CornerRadius="14" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="24,22" Margin="12">
    <Border.Effect>
      <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.45" Color="Black"/>
    </Border.Effect>
    <StackPanel>
      <DockPanel Margin="0,0,0,12">
        <Border x:Name="IconBg" Width="40" Height="40" CornerRadius="20" Background="{StaticResource AccentSoft}" Margin="0,0,14,0">
          <TextBlock x:Name="IconGlyph" Style="{StaticResource Icon}" FontSize="22" HorizontalAlignment="Center" Foreground="{StaticResource Accent}"/>
        </Border>
        <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
      </DockPanel>
      <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="{StaticResource Muted}" LineHeight="20"/>
      </ScrollViewer>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
        <Button x:Name="SecondaryBtn" Style="{StaticResource BtnGhost}" Margin="0,0,8,0" Click="Secondary_Click" IsCancel="True"/>
        <Button x:Name="PrimaryBtn" Style="{StaticResource Btn}" Click="Primary_Click" IsDefault="True"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
